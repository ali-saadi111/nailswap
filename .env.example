# ─────────────────────────────────────────────────────────────────────────────
# NailSwap environment variables
# Copy to .env.local for local development. Every variable used by the app is
# documented here. Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical public origin, no trailing slash. Used for absolute URLs, OG images,
# sitemap, WhatsApp deep links and payment return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain used for salon subdomains (slug.<domain>). Leave as-is locally;
# subdomains also work via ?salon=<slug> in development.
NEXT_PUBLIC_ROOT_DOMAIN=nailswap.app
# Platform default locale (ar | en | fr)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL, used by seed script and RLS policy tests.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Shared secret used by pg_cron/Edge Functions to call internal API routes.
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# ── AI try-on providers (server only) ────────────────────────────────────────
# Primary provider. fal.ai key from https://fal.ai/dashboard/keys
FAL_KEY=
# Secondary/failover provider. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Model identifiers. Defaults target the current best reference-guided inpainting models.
FAL_INPAINT_MODEL=fal-ai/flux-pro/v1/fill
FAL_MODERATION_MODEL=fal-ai/imageutils/nsfw
# AI photo try-on: reference-guided edit (hand photo + design photo, no mask). Tried in order.
FAL_EDIT_MODEL=fal-ai/nano-banana-2/edit
# Leave blank to avoid automatically paying for another model.
FAL_EDIT_FALLBACK_MODEL=
# Nano Banana output resolution; Seedream Lite uses auto_2K.
FAL_EDIT_RESOLUTION=1K
# "inpaint" forces the legacy mask + Flux Fill pipeline
AI_TRYON_PIPELINE=edit
REPLICATE_INPAINT_MODEL=black-forest-labs/flux-fill-pro
# Per-call timeout in ms and retry count before failing over.
AI_PROVIDER_TIMEOUT_MS=45000
AI_PROVIDER_RETRIES=0
AI_EDIT_TIMEOUT_MS=120000
# Approximate USD cost per generation, used for cost logging when a provider does not return one.
AI_COST_FAL_USD=0.05
AI_COST_FAL_EDIT_USD=0.08
AI_COST_REPLICATE_USD=0.05

# ── Mapbox ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (Upstash Redis). If unset, an in-memory limiter is used (dev only). ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
# Approved template names (see README → WhatsApp templates)
WHATSAPP_TEMPLATE_CONFIRMATION=booking_confirmation
WHATSAPP_TEMPLATE_REMINDER_24H=booking_reminder_24h
WHATSAPP_TEMPLATE_REMINDER_2H=booking_reminder_2h
WHATSAPP_TEMPLATE_PENDING=booking_pending
WHATSAPP_TEMPLATE_CANCELLED=booking_cancelled

# ── SMS fallback (Twilio) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="NailSwap <no-reply@nailswap.app>"

# ── Payments ─────────────────────────────────────────────────────────────────
# Card provider: "mpgs" (Mastercard Payment Gateway Services / Areeba, supports Lebanese merchants)
# or "none" to accept manual payments only.
PAYMENT_CARD_PROVIDER=mpgs
MPGS_MERCHANT_ID=
MPGS_API_PASSWORD=
MPGS_API_BASE_URL=https://ap-gateway.mastercard.com/api/rest/version/100
MPGS_WEBHOOK_SECRET=

# ── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Vercel Cron sends this header value as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me
