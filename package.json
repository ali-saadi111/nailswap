{
  "name": "nailswap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:lint": "supabase db lint --local --level error",
    "db:seed": "tsx scripts/seed.ts",
    "db:diff": "supabase db diff --local",
    "icons": "tsx scripts/generate-icons.ts",
    "models:download": "tsx scripts/download-models.ts",
    "designs:fetch": "tsx scripts/fetch-design-images.ts",
    "tryon:eval": "tsx scripts/tryon-eval.ts",
    "postinstall": "node -e \"try{require('fs').mkdirSync('public/models',{recursive:true})}catch{}\""
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/fiber": "^9.8.1",
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.48.0",
    "mapbox-gl": "^3.31.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "onnxruntime-web": "^1.30.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.5.2"
}
